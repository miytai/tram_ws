<?xml version="1.0"?>
<package format="3">
  <name>tram_backup_odometry</name>
  <version>1.0.0</version>
  <description>
    Model-based backup odometry for an autonomous tram: velocity and position
    from the driver controller position and the two bogie wheel speeds only
    (no GNSS and no IMU inside the estimation loop).
  </description>
  <maintainer email="team@tram.example.com">Hackathon Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tram_vehicle_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
